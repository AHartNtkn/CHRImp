 impl Prepared {
+    /// Requested storage of the changed representation, including all buffer
+    /// capacity, padding, and the entire Prepared header. Excludes unchanged
+    /// signature/name buffers and constructor/update plans; allocator phase
+    /// accounting separately measures the complete retained preparation heap.
+    #[cfg(feature = "diagnostics")]
+    pub fn representation_bytes(&self) -> usize {
+        std::mem::size_of::<Self>()
+            + self.instructions.capacity() * std::mem::size_of::<Instruction>()
+            + self
+                .instructions
+                .iter()
+                .map(|i| match i {
+                    Instruction::Post(a) => a.args.capacity() * std::mem::size_of::<usize>(),
+                    Instruction::And(xs) | Instruction::Or(xs) => {
+                        xs.capacity() * std::mem::size_of::<usize>()
+                    }
+                    _ => 0,
+                })
+                .sum::<usize>()
+            + self.rules.capacity() * std::mem::size_of::<RulePlan>()
+            + self
+                .rules
+                .iter()
+                .map(|r| {
+                    r.heads.capacity() * std::mem::size_of::<Atom>()
+                        + r.heads
+                            .iter()
+                            .map(|a| a.args.capacity() * std::mem::size_of::<usize>())
+                            .sum::<usize>()
+                })
+                .sum::<usize>()
+            + (self.triggers.capacity() + self.merge_triggers.capacity())
+                * std::mem::size_of::<Vec<(usize, usize)>>()
+            + self
+                .triggers
+                .iter()
+                .chain(&self.merge_triggers)
+                .map(|ts| ts.capacity() * std::mem::size_of::<(usize, usize)>())
+                .sum::<usize>()
+    }
+
